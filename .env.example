# Copy this file to .env and add only the provider keys you use.
URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# Gmail SMTP: use a Gmail app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Keep this true unless local TLS certificate verification fails.
SMTP_TLS_REJECT_UNAUTHORIZED=true
