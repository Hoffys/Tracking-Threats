# Copy this file to .env and add only the provider keys you use.
PUBLIC_DEPLOYMENT=false
VITE_PUBLIC_DEPLOYMENT=false
VITE_API_BASE_URL=
ADMIN_API_TOKEN=
STORE_SCAN_CONTENT=true
SCAN_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
SMTP_ENABLED=true
# Production repository: set DATABASE_URL to the private PostgreSQL connection URL.
# Local development falls back to DATABASE_PATH or backend/threattrack.sqlite.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10
DATABASE_PATH=
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=
CORS_ALLOW_CHROME_EXTENSIONS=false
CORS_ALLOW_NO_ORIGIN=true
JSON_BODY_LIMIT=512kb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1500
SCAN_RATE_LIMIT_WINDOW_MS=900000
SCAN_RATE_LIMIT_MAX=900

URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# Gmail SMTP: use a Gmail app password, not your normal account password.
# Mail sending is enabled when SMTP_HOST, SMTP_USER, and SMTP_PASS are set.
# Set SMTP_ENABLED=false only when you want to turn email sending off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Keep this true unless local TLS certificate verification fails.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Optional hosted fallback. Resend uses HTTPS instead of SMTP ports.
RESEND_API_KEY=
RESEND_FROM=
