# Copy this file to .env and add only the provider keys you use.
PUBLIC_DEPLOYMENT=false
VITE_PUBLIC_DEPLOYMENT=false
VITE_API_BASE_URL=
ADMIN_API_TOKEN=
STORE_SCAN_CONTENT=true
SMTP_ENABLED=true
DATABASE_PATH=
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=
CORS_ALLOW_CHROME_EXTENSIONS=false
CORS_ALLOW_NO_ORIGIN=true
JSON_BODY_LIMIT=512kb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1500
SCAN_RATE_LIMIT_WINDOW_MS=900000
SCAN_RATE_LIMIT_MAX=900

URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# Gmail SMTP: use a Gmail app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Keep this true unless local TLS certificate verification fails.
SMTP_TLS_REJECT_UNAUTHORIZED=true
