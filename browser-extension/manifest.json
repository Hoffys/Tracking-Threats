{
  "manifest_version": 3,
  "name": "Tracking Threats Browser Monitor",
  "version": "1.0.23",
  "description": "Scans visited pages and supported webmail content with Tracking Threats.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "webNavigation",
    "declarativeNetRequest",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:4000/*",
    "https://tracking-threats-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracking_threats_ad_malvertising_rules",
        "enabled": true,
        "path": "rules/adblock-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://tracking-threats-production.up.railway.app/*"
      ],
      "js": ["config.js", "app-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*",
        "https://www.bing.com/search*",
        "https://bing.com/search*",
        "https://duckduckgo.com/*",
        "https://search.yahoo.com/search*",
        "https://search.brave.com/search*",
        "https://www.ecosia.org/search*",
        "https://www.startpage.com/*",
        "https://yandex.com/search*"
      ],
      "js": ["config.js", "google-results.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://app.proton.me/*",
        "https://www.icloud.com/*",
        "https://mail.zoho.com/*",
        "https://mail.aol.com/*",
        "https://*.mail.com/*"
      ],
      "js": ["config.js", "email-monitor.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tracking Threats",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
